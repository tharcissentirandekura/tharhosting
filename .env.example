# Every line is optional: anything missing falls back to the default shown.
# Variables set in the real environment override this file.

# Address the control-plane API listens on.
THARHOSTING_HOST=127.0.0.1
THARHOSTING_PORT=8900

# Where db.json, build checkouts and deploy logs are stored.
# Default: `data/` in the directory you start the server from (the project).
# THARHOSTING_DATA=data

# First host port handed out to apps, and the interface they publish on.
THARHOSTING_APP_PORT_START=10000
THARHOSTING_APP_BIND=0.0.0.0

# Hostname used when printing app URLs.
THARHOSTING_PUBLIC_HOST=localhost

# Names or paths of the executables to run.
THARHOSTING_DOCKER=docker
THARHOSTING_GIT=git

# If set, every /api request needs `Authorization: Bearer <token>`.
# Leave unset only for local development.
THARHOSTING_TOKEN=change-me

# If set, GitHub webhooks must carry a valid X-Hub-Signature-256.
THARHOSTING_WEBHOOK_SECRET=change-me-too

# Log level: error, warn, info, debug, trace.
RUST_LOG=info
